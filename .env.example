# Core
CONTENTFLOW_ENVIRONMENT=development
CONTENTFLOW_DATABASE_URL=postgresql+psycopg://contentflow:replace-me@localhost:5432/contentflow
CONTENTFLOW_SECRET_KEY=replace-with-a-long-random-secret
CONTENTFLOW_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
CONTENTFLOW_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=[]
CONTENTFLOW_ALLOW_REGISTRATION=true
CONTENTFLOW_ALLOW_MOCK_PROVIDERS=true
CONTENTFLOW_REQUIRE_GOVERNED_PROMPTS=false
CONTENTFLOW_METRICS_ENABLED=false
CONTENTFLOW_METRICS_BEARER_TOKEN=
CONTENTFLOW_PROMETHEUS_RETENTION=15d
CONTENTFLOW_GRAFANA_BIND_ADDRESS=127.0.0.1
CONTENTFLOW_GRAFANA_PORT=3301
CONTENTFLOW_GRAFANA_ADMIN_USER=contentflow-admin
CONTENTFLOW_GRAFANA_ADMIN_PASSWORD=
CONTENTFLOW_GRAFANA_ROOT_URL=http://127.0.0.1:3301
CONTENTFLOW_GRAFANA_COOKIE_SECURE=false
CONTENTFLOW_ACCESS_TOKEN_MINUTES=15
CONTENTFLOW_REFRESH_TOKEN_DAYS=14
CONTENTFLOW_AUTH_COOKIE_DOMAIN=
CONTENTFLOW_TRUSTED_PROXY_HOPS=0
CONTENTFLOW_AUTH_RATE_LIMIT_ENABLED=true
CONTENTFLOW_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
CONTENTFLOW_AUTH_RATE_LIMIT_BLOCK_SECONDS=900
CONTENTFLOW_AUTH_LOGIN_ACCOUNT_ATTEMPTS=10
CONTENTFLOW_AUTH_LOGIN_IP_ATTEMPTS=50
CONTENTFLOW_AUTH_REGISTRATION_IP_ATTEMPTS=20
CONTENTFLOW_AUTH_REFRESH_SESSION_ATTEMPTS=120
CONTENTFLOW_AUTH_REFRESH_IP_ATTEMPTS=300
CONTENTFLOW_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3300","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3300","http://127.0.0.1:5173"]

# Storage: local or s3
CONTENTFLOW_STORAGE_BACKEND=local
CONTENTFLOW_LOCAL_STORAGE_DIR=.contentflow/storage
CONTENTFLOW_MAX_UPLOAD_BYTES=104857600
CONTENTFLOW_S3_ENDPOINT_URL=http://localhost:9000
CONTENTFLOW_S3_BUCKET=contentflow
CONTENTFLOW_S3_ACCESS_KEY=contentflow
CONTENTFLOW_S3_SECRET_KEY=replace-me

# AI providers are vendor-neutral. Live text/embedding use an explicit OpenAI-compatible endpoint.
CONTENTFLOW_TEXT_PROVIDER=mock
CONTENTFLOW_EMBEDDING_PROVIDER=hash
CONTENTFLOW_MODEL_API_BASE=
CONTENTFLOW_MODEL_API_KEY=
CONTENTFLOW_TEXT_MODEL=
CONTENTFLOW_EMBEDDING_MODEL=
CONTENTFLOW_EMBEDDING_DIMENSIONS=1024

# Media: mock or the vendor-neutral ContentFlow HTTP media contract.
CONTENTFLOW_IMAGE_PROVIDER=mock
CONTENTFLOW_VIDEO_PROVIDER=mock
CONTENTFLOW_MEDIA_API_BASE=
CONTENTFLOW_MEDIA_API_KEY=
CONTENTFLOW_MEDIA_DOWNLOAD_ALLOWED_HOSTS=[]
CONTENTFLOW_IMAGE_MODEL=
CONTENTFLOW_VIDEO_MODEL=

# Docker Compose
POSTGRES_PASSWORD=replace-me
CONTENTFLOW_POSTGRES_PORT=5432
MINIO_ROOT_USER=contentflow
MINIO_ROOT_PASSWORD=replace-me
CONTENTFLOW_RESTART_POLICY=unless-stopped
CONTENTFLOW_WORKER_STOP_GRACE_PERIOD=10m
CONTENTFLOW_WORKER_HEARTBEAT_SECONDS=10
CONTENTFLOW_WORKER_STALE_SECONDS=45
CONTENTFLOW_WORKER_QUEUE_STALL_SECONDS=300
CONTENTFLOW_PUBLISH_RECONCILIATION_INITIAL_DELAY_SECONDS=15
CONTENTFLOW_PUBLISH_RECONCILIATION_MAX_ATTEMPTS=20

# Optional registry mirror overrides
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-alpine
CONTENTFLOW_WEB_PORT=3000
