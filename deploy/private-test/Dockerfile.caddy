ARG CADDY_IMAGE=caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
FROM ${CADDY_IMAGE}

# Official binary requests CAP_NET_BIND_SERVICE. Our listener uses 8080, so
# remove the file capability to support cap_drop=ALL without granting privilege.
RUN setcap -r /usr/bin/caddy
USER 65532:65532
