{
  admin off
  auto_https off
  persist_config off
}

:8080 {
  route {
    # Keep the existing loopback/container health checks, but no localhost UI.
    @local_health {
      host localhost
      path /health/live /health/ready
    }
    handle @local_health {
      reverse_proxy api:8000
    }

    @wrong_host not host {$CONTENTFLOW_PRIVATE_HOST}
    respond @wrong_host "Use the authorized private HTTPS address" 403

    @backend path /api/* /health/live /health/ready
    handle @backend {
      reverse_proxy api:8000
    }
    handle {
      reverse_proxy web:3000
    }
  }
  request_body {
    max_size 105MB
  }
  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
  }
}
