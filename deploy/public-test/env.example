# Copy to .env on the server. Never commit the populated file.
# Image refs must include immutable @sha256 digests produced by build-images.yml.
CONTENTFLOW_BACKEND_IMAGE=ghcr.io/example/contentflow-backend@sha256:1111111111111111111111111111111111111111111111111111111111111111
CONTENTFLOW_WEB_IMAGE=ghcr.io/example/contentflow-web@sha256:2222222222222222222222222222222222222222222222222222222222222222
CONTENTFLOW_RELEASE_SHA=3333333333333333333333333333333333333333

CONTENTFLOW_DOMAIN=contentflow.example.com
CONTENTFLOW_ACME_EMAIL=admin@example.com

# Use URL-safe random hex so the password can be embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
CONTENTFLOW_SECRET_KEY=replace-with-an-independent-64-random-hex-key
CONTENTFLOW_CREDENTIAL_ENCRYPTION_KEY=replace-with-another-64-random-hex-key
CONTENTFLOW_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=[]
CONTENTFLOW_METRICS_BEARER_TOKEN=replace-with-a-third-independent-64-random-hex-key

# Worker queue, lease, health, and bounded database-availability recovery.
CONTENTFLOW_WORKER_POLL_SECONDS=1
CONTENTFLOW_WORKER_LEASE_SECONDS=300
CONTENTFLOW_WORKER_MAX_ATTEMPTS=4
CONTENTFLOW_WORKER_HEARTBEAT_SECONDS=10
CONTENTFLOW_WORKER_STALE_SECONDS=45
CONTENTFLOW_WORKER_QUEUE_STALL_SECONDS=300
CONTENTFLOW_WORKER_DATABASE_RETRY_INITIAL_SECONDS=1
CONTENTFLOW_WORKER_DATABASE_RETRY_MAX_SECONDS=30
CONTENTFLOW_WORKER_DATABASE_RETRY_MAX_ATTEMPTS=8
CONTENTFLOW_WORKER_DATABASE_RETRY_JITTER_RATIO=0.2

# Business objects: a bucket/token that cannot access the backup bucket.
CONTENTFLOW_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
CONTENTFLOW_S3_REGION=auto
CONTENTFLOW_S3_BUCKET=contentflow-public-test-objects
CONTENTFLOW_S3_ACCESS_KEY=replace-with-business-bucket-access-key
CONTENTFLOW_S3_SECRET_KEY=replace-with-business-bucket-secret-key

# Bounded storage accounting and report-only reconciliation scheduling.
CONTENTFLOW_WORKSPACE_STORAGE_MAX_BYTES=5368709120
CONTENTFLOW_WORKSPACE_STORAGE_MAX_OBJECTS=10000
CONTENTFLOW_STORAGE_RESERVATION_TTL_MINUTES=60
CONTENTFLOW_STORAGE_CLEANUP_BATCH_SIZE=100
CONTENTFLOW_STORAGE_DELETE_MAX_ATTEMPTS=20
CONTENTFLOW_STORAGE_ORPHAN_GRACE_SECONDS=86400
CONTENTFLOW_STORAGE_RECONCILE_SCHEDULE_ENABLED=true
CONTENTFLOW_STORAGE_RECONCILE_INTERVAL_HOURS=24
CONTENTFLOW_STORAGE_RECONCILE_SCHEDULE_BATCH_SIZE=25
CONTENTFLOW_STORAGE_RECONCILE_SCHEDULE_POLL_SECONDS=60

# Deterministic WeChat reconciliation and bounded recovery sweeps.
CONTENTFLOW_PUBLISH_RECONCILIATION_INITIAL_DELAY_SECONDS=15
CONTENTFLOW_PUBLISH_RECONCILIATION_MAX_ATTEMPTS=20
CONTENTFLOW_PUBLISH_RECONCILIATION_SWEEP_POLL_SECONDS=60
CONTENTFLOW_PUBLISH_RECONCILIATION_SWEEP_BATCH_SIZE=100

# Vendor-neutral OpenAI-compatible text endpoint.
CONTENTFLOW_MODEL_API_BASE=https://models.example.com/v1
CONTENTFLOW_MODEL_API_KEY=replace-with-text-model-api-key
CONTENTFLOW_TEXT_MODEL=replace-with-text-model-name
CONTENTFLOW_MODEL_REQUEST_TIMEOUT_SECONDS=120

# Default: fixed-revision local BGE-M3. To use a separate compatible embedding API,
# set provider=openai-compatible plus the three EMBEDDING_* values below.
CONTENTFLOW_EMBEDDING_PROVIDER=bge-m3-local
CONTENTFLOW_EMBEDDING_API_BASE=
CONTENTFLOW_EMBEDDING_API_KEY=
CONTENTFLOW_EMBEDDING_MODEL=
CONTENTFLOW_LOCAL_EMBEDDING_BATCH_SIZE=4

# Encrypted PostgreSQL backups: a second bucket/token with no business-bucket access.
CONTENTFLOW_BACKUP_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
CONTENTFLOW_BACKUP_S3_REGION=auto
CONTENTFLOW_BACKUP_S3_BUCKET=contentflow-public-test-backups
CONTENTFLOW_BACKUP_S3_ACCESS_KEY=replace-with-backup-only-access-key
CONTENTFLOW_BACKUP_S3_SECRET_KEY=replace-with-backup-only-secret-key
CONTENTFLOW_BACKUP_REPOSITORY_PASSWORD=replace-with-a-long-offline-copied-password
