{
  "name": "contentflow-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "start:local": "next start -p 3001",
    "dev:sites": "vinext dev",
    "build:sites": "vinext build",
    "test": "npm run build:sites && node --test tests/rendered-html.test.mjs tests/browser-session.test.mjs tests/generation-intents.test.mjs tests/publication-intents.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@cloudflare/vite-plugin": "1.61.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.1",
    "wrangler": "4.142.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "image-size": "2.0.4"
  },
  "type": "module"
}
